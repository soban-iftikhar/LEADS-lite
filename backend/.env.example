# OLX contact-info API tokens (same ones your main LEADS scraper uses)
OLX_ACCESS_TOKEN=
OLX_ID_TOKEN=
OLX_REFRESH_TOKEN=

# Separate Mongo instance/port so this can run alongside the main LEADS project
MONGO_URI=mongodb://leads_user:leads_password@127.0.0.1:27018/leads_lite?authSource=admin
MONGO_DATABASE=leads_lite

CALLBACK_BASE_URL=http://127.0.0.1:8000

# WhatsApp Cloud API — leave blank until your supervisor issues these.
# The campaign sender auto-detects missing credentials and runs in mock
# mode (simulates sent/delivered/read/failed) so Step 3/4 work end-to-end
# right now. Fill these in later and real sending kicks in automatically.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Any string you choose — you'll enter this same value when registering
# the webhook URL in the Meta app dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=leads_lite_verify
# Delay between sends, in seconds — keep this conservative to stay
# within WhatsApp's messaging rate limits.
WHATSAPP_SEND_DELAY_SECONDS=1.0
